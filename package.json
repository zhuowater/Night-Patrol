{
  "name": "night-patrol-soc",
  "version": "0.2.10",
  "private": true,
  "description": "网络安全主题卡牌构筑 roguelike demo",
  "main": "electron/main.cjs",
  "author": "zhuowater and Hermes",
  "license": "CC-BY-NC-4.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/zhuowater/Night-Patrol.git"
  },
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "desktop": "npm run build && electron .",
    "desktop:pack": "npm run build && electron-builder --dir",
    "desktop:dist": "npm run build && electron-builder --publish never",
    "check:theme": "node scripts/check-cybersec-theme.mjs",
    "check:attack-chain": "node scripts/check-attack-chain-counterplay.mjs",
    "check:engine-scenarios": "tsx scripts/check-engine-scenarios.ts",
    "check:playtest-run": "tsx scripts/check-playtest-runs.ts",
    "check:short-viewport": "tsx scripts/check-short-viewport-choice-screens.ts && tsx scripts/check-short-viewport-combat.ts",
    "check:map-build-gap": "tsx scripts/check-map-build-gap.ts",
    "assets:audit": "node scripts/audit-assets.mjs",
    "assets:optimize": "node scripts/optimize-assets.mjs",
    "check": "npm run check:theme && npm run check:attack-chain && npm run check:engine-scenarios && npm run check:playtest-run && npm run check:run-summary && npm run check:short-viewport && npm run check:map-build-gap",
    "check:run-summary": "tsx scripts/check-run-summary.ts"
  },
  "build": {
    "appId": "com.yexunlu.soc",
    "productName": "夜巡 SOC",
    "artifactName": "Night-Patrol-SOC-${version}-${os}-${arch}.${ext}",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "directories": {
      "buildResources": "desktop-assets",
      "output": "release"
    },
    "mac": {
      "category": "public.app-category.games",
      "identity": "-",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "icon": "desktop-assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "linux": {
      "icon": "desktop-assets/icon.png",
      "category": "Game",
      "target": [
        "AppImage",
        "zip"
      ]
    }
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "phaser": "^3.90.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.6.3",
    "vite": "^8.0.10"
  }
}
